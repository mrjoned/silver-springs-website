diff --git a/src/content/posts/spooky-springs-voting-general-updates.html b/src/content/posts/spooky-springs-voting-general-updates.html
deleted file mode 100644
index 9a3630d..0000000
--- a/src/content/posts/spooky-springs-voting-general-updates.html
