diff --git a/src/content/posts/mounts-of-mayhem-update-12111.html b/src/content/posts/mounts-of-mayhem-update-12111.html
deleted file mode 100644
index 3cc8ce6..0000000
--- a/src/content/posts/mounts-of-mayhem-update-12111.html
