---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { photos } from '../../lib/photos.js';
import hero from '../../content/pages/gallery-hero.html?raw';
import viewer from '../../content/pages/gallery-viewer.html?raw';
const years = [...new Set(photos.filter(p => p.year !== 'more').map(p => p.year))].sort().reverse();
---
<SiteLayout title="Gallery" description="Explore player builds and community memories from the Silver Springs Survival archives." styles={['/assets/site.css', '/assets/gallery-calendar.css']} scripts={['/assets/gallery.js']}>
  <main id="main">
    <Fragment set:html={hero} />
    <section class="wrap gallery-collection">
      <div class="gallery-toolbar">
        <div><span class="eyebrow">The collection</span><p id="photo-count" role="status">Showing all {photos.length} photos</p></div>
        <label>Browse the archives<select id="photo-filter"><option value="all">All photos</option>{years.map(year => <option value={year}>{year}</option>)}<option value="more">More moments</option></select></label>
      </div>
      <div class="photo-masonry">
        {photos.map((photo, index) => <button class="photo-tile" data-photo={photo.id} data-year={photo.year} aria-label={`View photo: ${photo.name}`}>
          <img src={photo.src} alt={photo.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
          <span class="photo-label"><span>{photo.name}</span><span aria-hidden="true">↗</span></span>
        </button>)}
      </div>
      {!photos.length && <p class="bodytext">Community photos will appear here when published.</p>}
      <p class="gallery-end">Every build and every gathering adds another chapter.</p>
      <a class="textlink" href="/about-us/">Get to know our community →</a>
    </section>
    <Fragment set:html={viewer} />
  </main>
</SiteLayout>
