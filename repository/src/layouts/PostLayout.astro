---
import SiteLayout from './SiteLayout.astro';
import PostTags from '../components/PostTags.astro';
const { post, older, newer } = Astro.props;
---
<SiteLayout title={post.title} description={post.excerpt} styles={['/assets/site.css', '/assets/news.css']}>
  <main id="main">
    <section class="inner-hero post-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/changelog-and-faq/">Announcements & FAQ</a></nav>
        <PostTags topics={post.topics} />
        <h1>{post.title}</h1>
        <div class="post-meta"><time datetime={post.dateISO}>{post.dateLabel}</time>{post.author ? ` · ${post.author}` : ''}</div>
      </div>
    </section>
    <div class="wrap post-layout">
      <article class="post-body"><Fragment set:html={post.body} /></article>
      <aside class="post-sidebar">
        <div class="eyebrow">Keep exploring</div><h3>More from Silver Springs.</h3>
        <a href="/changelog-and-faq/">← All announcements & FAQ</a>
        <a href="/calendar/">Event calendar →</a>
        <a href="/content-overview/">Custom Content & Guides →</a>
        <a href="/runecrafting-hub/">Runecrafting Hub →</a>
        <div class="sidebar-discord"><p>Updates appear on Discord first.</p><a href="https://discord.gg/r22U3prgPE">Join our Discord ↗</a></div>
      </aside>
    </div>
    <div class="wrap post-pagination">
      {older && <a href={older.path}><span>← Older post</span><strong>{older.title}</strong></a>}
      {newer && <a href={newer.path}><span>Newer post →</span><strong>{newer.title}</strong></a>}
    </div>
  </main>
</SiteLayout>
