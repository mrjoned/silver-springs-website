+<script>
+import {rushAt,countdown} from '../lib/rush-schedule.js';
+const banner=document.querySelector('.rush-banner');
+if(banner){
+ const title=banner.querySelector('[data-rush-title]')!,date=banner.querySelector('[data-rush-date]')!,timer=banner.querySelector('[data-rush-countdown]')!;
+ const local=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});
+ let previous='';
+ function update(){const now=Date.now(),rush=rushAt(now),key=rush.name+String(rush.active);if(key!==previous){title.textContent=`${rush.active?'Active':'Upcoming'} Rush: ${rush.name}`;banner!.classList.toggle('is-active',rush.active);date.textContent=`${rush.active?'Ends':'Starts'} ${local.format(new Date(rush.target))} · your local time`;previous=key;}timer.textContent=`${rush.active?'Ends':'Starts'} in ${countdown(rush.target-now)}`;}
