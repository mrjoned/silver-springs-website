 </style><script src="/assets/hub-data.js"></script></head><body><main><div class="eyebrow">Runecrafting Tools</div><h1>Rune Calculator</h1><p>Choose Runecrafted enchantments, set their levels and quantities, and get one combined rune shopping list. No equipment setup required.</p><section class="panel"><h2>1. Find enchantments</h2><label for="search" class="muted">Search by name or description</label><input id="search" class="search" type="search" placeholder="Try Aftershock, Transmuting, Protection…" autocomplete="off"><div id="results" class="results" aria-live="polite"></div><div class="tip">Runecrafted enchantments use runes. Vanilla+ upgrades cost one recipe per item, regardless of the upgrade level. Ordinary Vanilla and Mythical enchantments have no rune cost.</div></section><section class="panel"><div class="line"><h2>2. Your enchantments</h2><span id="itemCount" class="count">0 selected</span></div><div id="selected" class="selected"></div><div class="foot"><button id="clear" class="secondary" type="button">Clear Selection</button></div></section><section class="panel"><div class="line"><h2>3. Total runes needed</h2><span id="runeCount" class="count"></span></div><div id="totals" class="totals"></div><div class="foot"><button id="copy" class="pink" type="button">Copy Rune List</button></div><div id="copyStatus" class="status" role="status"></div></section><div id="status" class="status" role="status">Loading enchantment data…</div></main><script>
-(()=>{'use strict';let DATA=__SSS_ENCHANTMENT_DATA__;const $=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const roman=n=>{let r='';for(const [v,s] of [[10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']])while(n>=v){r+=s;n-=v}return r};const chosen=new Map();let resultsLimit=35;function upgrade(e){return e.costRule==='once'}function free(e){return e.costMode==='free'||(e.source!=='Runecrafted'&&e.source!=='Vanilla+')||!e.runes?.length}function renderResults(){const q=$('search').value.trim().toLowerCase();const matches=DATA.enchantments.filter(e=>!free(e)&&(!q||(e.name+' '+(e.description||'')).toLowerCase().includes(q))).sort((a,b)=>a.name.localeCompare(b.name));$('results').innerHTML=matches.slice(0,resultsLimit).map(e=>`<div class="result"><div><div class="name">${esc(e.name)}</div><div class="meta">${esc(e.source)} · ${free(e)?'No rune cost':`${e.runes.length} runes per ${upgrade(e)?'upgrade':'level'}`}</div></div><button class="${chosen.has(e.name)?'secondary':'pink'}" data-add="${esc(e.name)}" ${chosen.has(e.name)?'disabled':''}>${chosen.has(e.name)?'Added':'+ Add'}</button></div>`).join('')+(matches.length>resultsLimit?`<div class="empty">Showing ${resultsLimit} of ${matches.length}. Narrow your search to see more.</div>`:'')||'<div class="empty">No rune-cost enchantments found.</div>'}function renderSelected(){const rows=[...chosen.values()];$('itemCount').textContent=`${rows.length} selected`;$('selected').innerHTML=rows.length?rows.map(({e,level,qty})=>`<div class="entry"><div class="entryhead"><div><div class="name">${esc(e.name)}</div><div class="meta">${esc(e.source)} · ${free(e)?'No rune cost':upgrade(e)?'One upgrade recipe × quantity':'Runes × level × quantity'}</div></div><button class="remove" data-remove="${esc(e.name)}" aria-label="Remove ${esc(e.name)}">Remove</button></div><div class="controls">${!free(e)&&!upgrade(e)&&e.maxLevel>1?`<div><div class="meta">Level</div><div class="levels">${Array.from({length:Math.min(10,e.maxLevel)},(_,i)=>`<button class="level" aria-pressed="${level===i+1}" data-level="${i+1}" data-name="${esc(e.name)}">${roman(i+1)}</button>`).join('')}</div></div>`:!free(e)?`<span class="meta">${upgrade(e)?'Upgrade '+esc(e.name.match(/ (III|IV|V|VI|VII|VIII|IX|X)$/)?.[1]||'once'):'Level '+roman(level)}</span>`:''}<label>Quantity <input class="qty" type="number" min="1" max="999" step="1" value="${qty}" data-qty="${esc(e.name)}" aria-label="Quantity for ${esc(e.name)}"></label></div>${!free(e)?`<div class="detail">${upgrade(e)?'One-time upgrade recipe':'Recipe per level'}: ${esc(e.runes.join(' · '))}</div>`:''}</div>`).join(''):'<div class="empty">Nothing selected yet. Search above and click + Add.</div>';renderTotals();renderResults()}function counts(){const map=new Map();for(const {e,level,qty} of chosen.values()){if(free(e))continue;for(const rune of e.runes)map.set(rune,(map.get(rune)||0)+(upgrade(e)?1:level)*qty)}return [...map.entries()].sort((a,b)=>a[0].localeCompare(b[0]))}function renderTotals(){const entries=counts();$('runeCount').textContent=entries.length?`${entries.reduce((sum,[,n])=>sum+n,0)} runes total`:'No runes needed';$('totals').innerHTML=entries.length?entries.map(([r,n])=>`<div class="total"><span>${esc(r)}</span><strong>${n.toLocaleString()}</strong></div>`).join(''):'<div class="empty">Add a Runecrafted enchantment to calculate rune requirements.</div>';$('copy').disabled=!entries.length}function refreshData(data){if(!Array.isArray(data.enchantments))throw Error('Invalid enchantment data');DATA=data;for(const [name,row] of chosen){const e=DATA.enchantments.find(x=>x.name===name);if(e&&!free(e)){row.e=e;row.level=upgrade(e)?1:Math.min(row.level,Math.max(1,e.maxLevel||1))}else chosen.delete(name)}renderSelected()}$('results').addEventListener('click',ev=>{const btn=ev.target.closest('[data-add]');if(!btn)return;const e=DATA.enchantments.find(x=>x.name===btn.dataset.add);if(!e||fre