---
import { posts } from '../lib/posts.js';
---
<section class="wrap" id="news">
  <div class="sectionhead">
    <div><div class="eyebrow">Around the server</div><h2>Latest updates</h2></div>
    <a class="textlink" href="/changelog-and-faq/">All website updates →</a>
  </div>
  <div class="news">
    {posts.slice(0, 2).map((post) => <article>
      <time datetime={post.dateISO}>{post.dateLabel.toUpperCase()}</time>
      <h3><a href={post.path}>{post.title}</a></h3>
      <div class="announcement-summary" set:html={post.excerptHtml} />
      <a class="textlink" href={post.path}>Read the announcement →</a>
    </article>)}
    <article><h3>What’s coming up?</h3><p>There’s always something on the calendar, from weekly Rush events to resource world resets every other week, plus the occasional special event!</p><a class="textlink" href="/calendar/">Check the calendar →</a></article>
  </div>
  <div class="discordnote"><span>We post updates on Discord first.</span><a href="https://discord.gg/r22U3prgPE">Visit our Discord ↗</a></div>
</section>

<style is:global>
.announcement-summary p{margin:0 0 .65em}.announcement-summary > :last-child{margin-bottom:0}.announcement-summary ul,.announcement-summary ol{padding-left:1.4em}.announcement-summary a{text-decoration:underline}
</style>
