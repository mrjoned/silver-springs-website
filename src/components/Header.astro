---
const path = Astro.url.pathname;
const active = (href) => path === href || (href !== '/' && path.startsWith(href));
const community = [
  { href: '/about-us/', label: 'About Us' },
  { href: '/staffoverview/', label: 'Meet the staff' }
];
const around = [
  { href: '/gallery/', label: 'Gallery' },
  { href: '/changelog-and-faq/', label: 'Announcements, Changelog & FAQ' },
  { href: '/calendar/', label: 'Event calendar' },
  { href: '/map/', label: 'Live server map' }
];
---
<header class="wrap top">
  <a class="brand" href="/">
    <span class="mark" aria-hidden="true">🌸</span>
    <span>SILVER SPRINGS<small>SURVIVAL</small></span>
  </a>
  <button class="menu" aria-expanded="false" aria-controls="mainnav">Menu</button>
  <nav id="mainnav" aria-label="Main navigation">
    <a href="/" aria-current={active('/') ? 'page' : undefined}>Home</a>
    <a href="/content-overview/" aria-current={active('/content-overview/') ? 'page' : undefined}>Custom Content</a>
    <a href="/runecrafting-hub/" aria-current={active('/runecrafting-hub/') ? 'page' : undefined}>Runecrafting Hub</a>
    <details class="navgroup">
      <summary>Get to know us <span aria-hidden="true">⌄</span></summary>
      <div class="navdrop">
        {community.map(({ href, label }) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      </div>
    </details>
    <details class="navgroup">
      <summary>Around the server <span aria-hidden="true">⌄</span></summary>
      <div class="navdrop">
        {around.map(({ href, label }) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      </div>
    </details>
    <a class="navjoin" href="https://discord.gg/r22U3prgPE">Discord ↗</a>
  </nav>
</header>
