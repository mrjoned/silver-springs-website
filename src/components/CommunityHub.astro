---
import { photos } from '../lib/photos.js';
import viewer from '../content/pages/gallery-viewer.html?raw';

const worldFiles = import.meta.glob('../content/world-archives/*.json', { eager: true, import: 'default' });
const archives = Object.values(worldFiles).filter((archive) => !archive.draft).sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const videoFiles = import.meta.glob('../content/videos/*.json', { eager: true, import: 'default' });
const videoDate = (video) => {
  const date = Date.parse(video.date || '');
  return Number.isFinite(date) ? date : null;
};
const videos = Object.values(videoFiles).filter((video) => !video.draft).sort((a, b) => {
  const first = videoDate(a);
  const second = videoDate(b);
  if (first === null && second !== null) return 1;
  if (second === null && first !== null) return -1;
  return (second ?? 0) - (first ?? 0) || (a.order ?? 0) - (b.order ?? 0);
});
const years = [...new Set(photos.filter((photo) => photo.year !== 'more').map((photo) => photo.year))].sort().reverse();
const generationLabel = archives.length === 1 ? 'generation' : 'generations';
const initialTab = Astro.props.initialTab ?? 'gallery';
const categoryKey = (value) => (value ?? '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
const safeVideoUrl = (value) => {
  try {
    const url = new URL(value);
    return ['https:', 'http:'].includes(url.protocol) ? url.href : null;
  } catch { return null; }
};
const safeYouTubeId = (value) => /^[A-Za-z0-9_-]{11}$/.test(value ?? '') ? value : null;
const twitchClipSlug = (videoUrl) => {
  if (!videoUrl) return null;

  const { hostname, pathname } = new URL(videoUrl);
  if (hostname === 'clips.twitch.tv' && pathname !== '/embed' && pathname !== '/embed/') {
    return pathname.match(/^\/([\w-]+)\/?$/)?.[1] ?? null;
  }
  if (hostname === 'www.twitch.tv' || hostname === 'twitch.tv') {
    return pathname.match(/^\/[\w-]+\/clip\/([\w-]+)\/?$/)?.[1] ?? null;
  }
  return null;
};
const categories = new Map([
  ['map-launch', 'Map Launches'],
  ['community-event', 'Community Events'],
  ['pvp-tournament', 'PvP Tournaments'],
  ['server-review', 'Server Reviews'],
  ['mob-arena', 'Mob Arenas'],
  ['trailer', 'Trailers'],
  ['uncategorized', 'Uncategorized']
]);
const wikiBase = 'https://silver-springs-survival.fandom.com/wiki/';
const arenaFeatures = [
  {
    name: 'Dawntreader',
    wikiPage: 'Dawntreader',
    description: 'A multi-level team arena with 30 waves. The old recordings show players fighting through later rounds and celebrating one of their early wins.',
    recordings: [
      ['SyaPjWGNQT4', 'Watch Round 3'],
      ['8a46nbA2tJk', 'Watch the third win'],
    ],
  },
  {
    name: 'Hellfire',
    wikiPage: 'Hellfire',
    description: 'A Nether-themed arena where players could take on classes inspired by Nether mobs.',
    recordings: [['Iap6CZRjLVQ', 'Watch Hellfire gameplay']],
  },
].map((arena) => {
  const recordings = arena.recordings.flatMap(([id, label]) => {
    const video = videos.find((entry) => entry.youtubeId === id);
    if (!video) return [];
    return [{
      label,
      url: safeVideoUrl(video.videoUrl) ?? `https://www.youtube.com/watch?v=${id}`,
      thumbnail: video.thumbnail || `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
    }];
  });
  return { ...arena, recordings };
});
const arenaNotes = [
  ['DesertStorm', 'DesertStorm', 'An arena from an earlier map with its own class kits and boss encounters.'],
  ['Ice', 'Ice', 'A 15-wave solo arena, shorter than most of the old Mob Arenas.'],
  ['Plague', 'Plague', 'A solo arena that packed its encounters into 10 waves.'],
  ['International Silver Springs Station', 'ISSS', 'A space-station arena where players earned credits to unlock doors and upgrade gear at the power core.'],
  ['LowerSpire', 'LowerSpire', 'A three-level arena with 30 waves, from an upper ring down to the main floor.'],
  ['SpiresPeak', 'SpiresPeak', 'A one-wave boss fight set above LowerSpire.'],
];
---
<main id="main" class="community-hub" data-initial-tab={initialTab}>
  <section class="inner-hero community-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Community Archive</span></nav>
      <div class="eyebrow">Silver Springs through the years</div>
      <h1>Community Archive</h1>
      <p>Builds, maps, and memories from the people, places, and events that shaped Silver Springs.</p>
    </div>
  </section>

  <div class="wrap community-tabs-wrap">
    <nav class="community-tabs" role="tablist" aria-label="Community Archive sections">
      <a class="community-tab" id="tab-gallery" role="tab" href="#community-gallery" aria-controls="community-gallery" aria-selected={initialTab === 'gallery' ? 'true' : 'false'}>Gallery</a>
      <a class="community-tab" id="tab-maps" role="tab" href="#community-maps" aria-controls="community-maps" aria-selected={initialTab === 'maps' ? 'true' : 'false'}>Map Archive</a>
      <a class="community-tab" id="tab-videos" role="tab" href="#community-videos" aria-controls="community-videos" aria-selected={initialTab === 'videos' ? 'true' : 'false'}>Video Archive</a>
      <a class="community-tab" id="tab-retired-arenas" role="tab" href="#retired-arenas" aria-controls="retired-arenas" aria-selected="false">Retired Arenas</a>
    </nav>
  </div>

  <section class="community-panel" id="community-gallery" role="tabpanel" aria-labelledby="tab-gallery" tabindex="0">
    <div class="wrap community-panel-heading">
      <div class="eyebrow">A world made by its players</div>
      <h2>Our world. <em>Our memories.</em></h2>
      <p>Builds worth wandering through. Moments worth coming back to. A look through the Silver Springs community archives.</p>
    </div>
    <div class="wrap gallery-collection">
      <div class="gallery-toolbar">
        <div><span class="eyebrow">The collection</span><p id="photo-count" role="status">Showing all {photos.length} photos</p></div>
        <label>Browse the archives<select id="photo-filter"><option value="all">All photos</option>{years.map((year) => <option value={year}>{year}</option>)}<option value="more">More moments</option></select></label>
      </div>
      <div class="photo-masonry">
        {photos.map((photo, index) => <button class="photo-tile" data-photo={photo.id} data-year={photo.year} aria-label={`View photo: ${photo.name}`}>
          <img src={photo.src} alt={photo.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
          <span class="photo-label"><span>{photo.name}</span><span aria-hidden="true">↗</span></span>
        </button>)}
      </div>
      {!photos.length && <p class="bodytext">Community photos will appear here when published.</p>}
      <p class="gallery-end">Every build and every gathering adds another chapter.</p>
      <a class="textlink" href="/about-us/">Get to know our community →</a>
    </div>
    <Fragment set:html={viewer} />
  </section>

  <section class="community-panel" id="community-maps" role="tabpanel" aria-labelledby="tab-maps" tabindex="0">
    <section class="wrap archive-section">
      <div class="community-panel-heading">
        <div class="eyebrow">Explore our past worlds</div>
        <h2>{archives.length} {generationLabel} of Silver Springs history</h2>
        <p>Our worlds may change, but the memories don't have to. Revisit the builds, adventures, and communities that shaped Silver Springs.</p>
      </div>
      <div class="archive-grid">
        {archives.map((archive) => <article class="archive-card">
          <div class="archive-card-top"><span class="archive-version">{archive.name}</span><span class="archive-status">Minecraft {archive.version}</span></div>
          <p class="archive-size">{archive.size}</p>
          {archive.status && <p class="archive-notes">{archive.status}</p>}
          {archive.notes && <p class="archive-notes">{archive.notes}</p>}
          {archive.downloadUrl ? <a class="btn primary" href={archive.downloadUrl} download>Download world ↓</a> : <span class="btn archive-disabled" aria-disabled="true">Coming soon</span>}
          {archive.checksum && <code class="archive-checksum">SHA-256: {archive.checksum}</code>}
        </article>)}
      </div>
      {!archives.length && <p class="bodytext">Archived worlds will appear here as they are prepared for download.</p>}
    </section>
    <section class="contentband">
      <div class="wrap archive-howto">
        <div><div class="eyebrow">How to play an archived world</div><h2>Bring an old world back to life.</h2></div>
        <div>
          <ol>
            <li><strong>Download and extract the ZIP.</strong> Keep the world folder itself.</li>
            <li><strong>Use a compatible Minecraft Java version.</strong></li>
            <li><strong>Move the world into your Minecraft saves folder.</strong></li>
          </ol>
          <p class="archive-note">Some server worlds may need additional preparation for single-player use. Check each archive for compatibility notes and verified checksums.</p>
        </div>
      </div>
    </section>
  </section>

  <section class="community-panel" id="community-videos" role="tabpanel" aria-labelledby="tab-videos" tabindex="0">
    <section class="wrap video-archive-section">
      <div class="community-panel-heading">
        <div class="eyebrow">Events, launches, and live moments</div>
        <h2>Video Archive</h2>
        <p>Watch map beginnings, community events, PvP tournaments, and full livestream recordings from Silver Springs.</p>
      </div>
      {videos.length ? (
        <>
          <div id="video-controls" hidden>
            <div class="video-categories" role="group" aria-label="Video categories">
              <button type="button" data-video-filter="all" aria-pressed="true" aria-controls="video-grid">All Videos</button>
              {[...categories].map(([key, label]) => (
                <button type="button" data-video-filter={key} aria-pressed="false" aria-controls="video-grid">{label}</button>
              ))}
            </div>
            <div class="video-toolbar">
              <p id="video-count" role="status"></p>
              <label>Sort by date
                <select id="video-sort">
                  <option value="newest">Newest first</option>
                  <option value="oldest">Oldest first</option>
                </select>
              </label>
            </div>
          </div>
          <div class="video-grid" id="video-grid" role="region" aria-label="Videos" tabindex="-1">
            {videos.map((video) => {
              const key = categoryKey(video.category);
              const category = categories.has(key) ? key : 'uncategorized';
              const videoUrl = safeVideoUrl(video.videoUrl);
              const twitchClip = twitchClipSlug(videoUrl);
              const youtubeId = safeYouTubeId(video.youtubeId);
              const platform = twitchClip ? 'twitch' : youtubeId ? 'youtube' : null;
              const watchUrl = videoUrl ?? (youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}` : null);
              const thumbnail = video.thumbnail || (platform === 'youtube' ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : null);

              return <article class="video-card" data-video-category={category} data-video-date={videoDate(video)}>
                <div class="video-media">
                  <div class="video-preview">
                    {thumbnail
                      ? <img class="video-thumbnail" src={thumbnail} alt={video.thumbnailAlt || ''} loading="lazy" decoding="async" />
                      : <div class="video-art" aria-hidden="true"><span>▶</span></div>}
                    {platform && (
                      <button
                        type="button"
                        class="video-play"
                        data-video-platform={platform}
                        data-video-id={twitchClip ?? youtubeId}
                        aria-label={`Play ${video.title}`}
                        hidden
                      ><span class="btn primary">▶ Play</span></button>
                    )}
                  </div>
                </div>
                <div class="video-card-content">
                  <div class="video-meta"><span>{categories.get(category)}</span>{video.format && <span>{video.format}</span>}{video.date && <time datetime={video.date}>{video.date}</time>}</div>
                  <h3>{video.title}</h3>
                  {video.description && <p>{video.description}</p>}
                  {watchUrl && <a class="textlink" href={watchUrl} target="_blank" rel="noopener noreferrer">{twitchClip ? 'Watch on Twitch ↗' : 'Watch video ↗'}</a>}
                </div>
              </article>;
            })}
          </div>
          <p id="video-filter-empty" class="video-filter-empty" hidden>No videos in this category yet.</p>
          <nav id="video-pages" class="video-pages" aria-label="Video archive pages" hidden>
            <button type="button" class="btn" id="video-previous">← Previous</button>
            <span id="video-page-number"></span>
            <button type="button" class="btn" id="video-next">Next →</button>
          </nav>
        </>
      ) : (
        <div class="video-empty">
          <span class="video-empty-icon" aria-hidden="true">▶</span>
          <h3>The archive is just getting started.</h3>
          <p>Silver Springs videos will appear here as recordings are added, from map launches and community events to tournament highlights and full VODs.</p>
        </div>
      )}
    </section>
  </section>

  <section class="community-panel" id="retired-arenas" role="tabpanel" aria-labelledby="tab-retired-arenas" tabindex="0">
    <div class="wrap retired-arena-section">
      <div class="community-panel-heading">
        <h2>Retired Arenas</h2>
        <p>Revisit the Mob Arenas and Valor Arenas of earlier Silver Springs maps, with gameplay recordings and notes from the old wiki.</p>
      </div>
      <div class="video-grid">
        {arenaFeatures.map((arena) => (
          <article class="video-card">
            {arena.recordings[0] && <img class="video-thumbnail" src={arena.recordings[0].thumbnail} alt="" loading="lazy" decoding="async" />}
            <div class="video-card-content">
              <h3>{arena.name}</h3>
              <p>{arena.description}</p>
              <ul class="arena-links">
                {arena.recordings.map((video) => (
                  <li><a class="textlink" href={video.url} target="_blank" rel="noopener noreferrer">{video.label} ↗</a></li>
                ))}
                <li><a class="textlink" href={wikiBase + arena.wikiPage} aria-label={`Wiki notes for ${arena.name}`}>Wiki notes ↗</a></li>
              </ul>
            </div>
          </article>
        ))}
      </div>
      <section class="arena-notes" aria-labelledby="other-retired-arenas">
        <h3 id="other-retired-arenas">More arenas from past maps</h3>
        <div class="arena-notes-grid">
          {arenaNotes.map(([name, wikiPage, description]) => (
            <article>
              <h4>{name}</h4>
              <p>{description}</p>
              <a class="textlink" href={wikiBase + wikiPage} aria-label={`Wiki notes for ${name}`}>Wiki notes ↗</a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>
</main>

<style>
  .retired-arena-section {
    padding-block: 28px 90px;
  }

  .arena-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }

  .arena-notes {
    margin-top: 48px;
  }

  .arena-notes h3 {
    margin: 0 0 20px;
    font-size: clamp(24px, 3vw, 32px);
  }

  .arena-notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 16px;
  }

  .arena-notes-grid article {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--panel);
  }

  .arena-notes-grid h4 {
    margin: 0;
    font-size: 19px;
  }

  .arena-notes-grid p {
    margin: 8px 0 16px;
    color: var(--muted);
    font-size: 14px;
  }

  .arena-notes-grid a {
    margin-top: auto;
  }
</style>
