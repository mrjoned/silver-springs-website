---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {
  title = 'Silver Springs Survival',
  description = 'Discover Silver Springs Survival and its community, custom content, and player tools.',
  styles = ['/assets/site.css'],
  scripts = [],
  noindex = false
} = Astro.props;
const pageTitle = title === 'Silver Springs Survival' ? title : `${title} · Silver Springs Survival`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}
    <script is:inline src="/assets/site.js" defer></script>
    {scripts.map((src) => <script is:inline src={src} defer></script>)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <div class="toast" id="toast" role="status" hidden></div>
  </body>
</html>
