---
import SiteLayout from '../layouts/SiteLayout.astro';
import LatestNews from '../components/LatestNews.astro';
import beforeNews from '../content/pages/home-before-news.html?raw';
import afterNews from '../content/pages/home-after-news.html?raw';
---
<SiteLayout title="Silver Springs Survival · A world worth coming back to" description="Discover Silver Springs Survival: community builds, custom enchantments, and your next Minecraft adventure." styles={['/assets/site.css']}>
  <main id="main">
    <Fragment set:html={beforeNews} />
    <LatestNews />
    <Fragment set:html={afterNews} />
  </main>
</SiteLayout>
