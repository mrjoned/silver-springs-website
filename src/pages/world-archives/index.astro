---
import SiteLayout from '../../layouts/SiteLayout.astro';

const files = import.meta.glob('../../content/world-archives/*.json', {
  eager: true,
  import: 'default'
});

const archives = Object.values(files)
  .filter((archive) => !archive.draft)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const generationLabel = archives.length === 1 ? 'generation' : 'generations';
---

<SiteLayout
  title="World Archives"
  description="Revisit the builds, adventures, and communities that shaped Silver Springs Survival."
  styles={['/assets/site.css', '/assets/world-archives.css']}
>
  <main id="main">
    <section class="inner-hero world-archives-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>World Archives</span>
        </nav>

        <div class="hero-grid">
          <div>
            <div class="eyebrow">Silver Springs Survival</div>
            <h1>World Archives</h1>
            <p>
              Our worlds may change, but the memories don't have to. Revisit the
              builds, adventures, and communities that shaped Silver Springs.
            </p>
          </div>

          <figure>
            <img src="/assets/spawn.jpg" alt="A view of the Silver Springs spawn town" fetchpriority="high">
            <figcaption>A little corner of Silver Springs.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="wrap archive-section">
      <div class="sectionhead">
        <div>
          <div class="eyebrow">Explore our past worlds</div>
          <h2>{archives.length} {generationLabel} of Silver Springs history</h2>
        </div>
        <p>
          We're preparing each world for download. Archive cards become active
          as their files are uploaded, checked, and ready to share.
        </p>
      </div>

      <div class="archive-grid">
        {archives.map((archive) => (
          <article class="archive-card">
            <div class="archive-card-top">
              <span class="archive-version">Minecraft {archive.version}</span>
              <span class="archive-status">{archive.status}</span>
            </div>

            <p class="archive-size">{archive.size}</p>

            {archive.notes && <p class="archive-notes">{archive.notes}</p>}

            {archive.downloadUrl ? (
              <a class="btn primary" href={archive.downloadUrl} download>
                Download world ↓
              </a>
            ) : (
              <span class="btn archive-disabled" aria-disabled="true">
                Coming soon
              </span>
            )}

            {archive.checksum && (
              <code class="archive-checksum">
                SHA-256: {archive.checksum}
              </code>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="contentband">
      <div class="wrap archive-howto">
        <div>
          <div class="eyebrow">How to play an archived world</div>
          <h2>Bring an old world back to life.</h2>
        </div>

        <div>
          <ol>
            <li><strong>Download and extract the ZIP.</strong> Keep the world folder itself.</li>
            <li><strong>Use a compatible Minecraft Java version.</strong></li>
            <li><strong>Move the world into your Minecraft saves folder.</strong></li>
          </ol>

          <p class="archive-note">
            Some server worlds may need additional preparation for single-player
            use. We’ll add compatibility notes and verified checksums as each
            archive is published.
          </p>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
